# TRACEONE AI Investigator Environment Configuration Template
# DO NOT put real API keys in this example file. Copy to .env for local overrides.

# Default LLM Provider: 'ollama', 'mistral', or 'mock'
TRACEONE_LLM_PROVIDER=ollama
TRACEONE_LLM_MODEL=qwen3:8b

# Local Ollama Endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Mistral Cloud API Configuration
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest
